#!/usr/bin/env bash

set -euo pipefail

#shellcheck disable=SC1091
source "${DOCKER_DIR}/scripts/functions.bash"

# $1 = repo desc
# $2 = service
function run_backup() {
  log "Running $1 backup"
  docker compose --file "${DOCKER_COMPOSE_DIR}/restic/compose.yaml" run --rm "restic-$2"
  log "Ran $1 backup"
}

if [[ "$#" -eq 0 ]]; then
  if prompt_yn 'Run local backup?'; then
    readonly run_local=1
  fi
  if prompt_yn 'Run Backblaze B2 backup?'; then
    readonly run_b2=1
  fi
  if prompt_yn 'Run Cloudflare R2 backup?'; then
    readonly run_r2=1
  fi
else
  for arg in "$@"; do
    case "${arg}" in
      'local')
        readonly run_local=1
        ;;
      'b2')
        readonly run_b2=1
        ;;
      'r2')
        readonly run_r2=1
        ;;
      *)
        die "Unexpected backup type: ${arg}"
        ;;
    esac
  done
fi

if [[ -n "${run_local:-}" ]]; then
  run_backup 'local' 'local'
fi
if [[ -n "${run_b2:-}" ]]; then
  run_backup 'Backblaze B2' 'b2'
fi
if [[ -n "${run_r2:-}" ]]; then
  run_backup 'Cloudflare R2' 'r2'
fi

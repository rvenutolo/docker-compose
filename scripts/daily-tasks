#!/usr/bin/env bash

set -euo pipefail

#shellcheck disable=SC1091
source "${DOCKER_DIR}/functions.bash"

log 'Running daily tasks'

"$(this_script_dir)/run-crowdsec-hub-update-upgrade"

log 'Stopping containers before backup'
for dir in "${DOCKER_APP_DATA_DIR}"/*; do
  name="$(basename "${dir}")"
  log "Running docker compose down for: ${name}"
  docker compose --file "${DOCKER_COMPOSE_DIR}/${name}/compose.yaml" down
done
log 'Stopped containers before backup'

log 'Running backups'
"$(this_script_dir)/run-backups" 'local' 'b2' 'r2'
log 'Ran backups'

log 'Starting containers stopped for backup'
readonly ignore_filename='.dc_ignore'
for dir in "${DOCKER_APP_DATA_DIR}"/*; do
  name="$(basename "${dir}")"
  if ! file_exists "${DOCKER_COMPOSE_DIR}/${name}/${ignore_filename}"; then
    log "Running docker compose up for: ${name}"
    docker compose --file "${DOCKER_COMPOSE_DIR}/${name}/compose.yaml" up --detach
  fi
done
log 'Started containers stopped for backup'

log 'Running backup maintenance'
"$(this_script_dir)/run-backup-maintenance" 'local' 'b2' 'r2'
log 'Ran backup maintenance'

"$(this_script_dir)/run-watchtower"

log "Ran daily tasks in $(shell_elapsed_time)"

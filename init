#!/usr/bin/env bash

set -euo pipefail

#shellcheck disable=SC1091
source "${DOCKER_COMPOSE_DIR}/functions.bash"

for env_var in \
  BACKUP_DIR \
  DATA_DIR \
  DOCKER_APP_DATA_DIR \
  DOCKER_COMPOSE_DIR \
  DOCKER_DIR \
  DOCKER_LOGS_DIR \
  DOCKER_SOCKET \
  DOCKER_TZ \
  DOMAIN_NAME \
  DOMAIN_NAME_REGEX \
  PGID \
  PUID \
  TAILNET_IP \
  USER; do
    if [[ -z "${env_var:-}" ]]; then
      die='DIE'
      log "${env_var} is not set to a non-empty value"
    fi
done

if [[ -n "${die:-}" ]]; then
  die 'Fix the missing env vars and re-run this script'
fi

create_dir "${DOCKER_APP_DATA_DIR}"
create_dir "${DOCKER_LOGS_DIR}"

proxy_network='proxy'
if ! docker network inspect "${proxy_network}" &> '/dev/null'; then
  log "Creating ${proxy_network} network"
  docker network create "${proxy_network}" --subnet "${DOCKER_PROXY_NETWORK_SUBNET_CIDR}" --gateway "${DOCKER_PROXY_NETWORK_GATEWAY}"
  log "Created ${proxy_network} network"
fi

if prompt_yn "Run init scripts?"; then
  init_scripts="$(find . -mindepth 2 -type f -name 'init' | sort)"
  for init_script in ${init_scripts}; do
    if prompt_yn "Run ${init_script:2}?"; then
      log "Running ${init_script:2}"
      "${init_script}"
      log "Ran ${init_script:2}"
    fi
  done
fi

readonly systemd_service_dir="${XDG_CONFIG_DIR}/systemd/user/"
copy_file "$(this_script_dir)/daily-tasks.service" "${systemd_service_dir}/daily-tasks.service"
copy_file "$(this_script_dir)/daily-tasks.timer" "${systemd_service_dir}/daily-tasks.timer"
if ! systemctl is-enabled --user --quiet 'daily-tasks.timer'; then
  log 'Enabling daily-tasks timer'
  systemctl enable --now --user --quiet 'daily-tasks.timer'
  log 'Enabled daily-tasks timer'
fi

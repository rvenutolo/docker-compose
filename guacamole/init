#!/usr/bin/env bash

set -euo pipefail

#shellcheck disable=SC1091
source "${DOCKER_COMPOSE_DIR}/functions.bash"

readonly app_data_dir="${DOCKER_APP_DATA_DIR}/guacamole"
create_dir_or_change_ownership "${app_data_dir}"

readonly postgres_init_dir="${app_data_dir}/postgres/init"
create_dir_or_change_ownership "${postgres_init_dir}"

readonly postgres_init_file="${postgres_init_dir}/init-db.sql"
readonly postgres_init_file_content="$(docker run --rm guacamole/guacamole:latest /opt/guacamole/bin/initdb.sh --postgresql)"
create_or_overwrite_file "${postgres_init_file}" "${postgres_init_file_content}"
